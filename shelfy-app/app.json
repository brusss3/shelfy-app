{
  "expo": {
    "name": "Shelfy",
    "slug": "shelfy",
    "version": "1.0.0",
    "orientation": "portrait",
    "icon": "./assets/icon.png",
    "userInterfaceStyle": "light",
    "assetBundlePatterns": [
      "**/*"
    ],
    "ios": {
      "supportsTablet": false,
      "bundleIdentifier": "it.shelfyapp",
      "infoPlist": {
        "NSCameraUsageDescription": "Shelfy usa la fotocamera per scansionare i codici a barre dei prodotti.",
        "NSUserNotificationsUsageDescription": "Shelfy invia notifiche quando i tuoi prodotti stanno per scadere."
      }
    },
    "android": {
      "adaptiveIcon": {
        "foregroundImage": "./assets/adaptive-icon.png",
        "backgroundColor": "#fff9ed"
      },
      "package": "it.shelfyapp",
      "permissions": [
        "CAMERA",
        "RECEIVE_BOOT_COMPLETED",
        "VIBRATE",
        "android.permission.CAMERA"
      ],
      "googleServicesFile": "./google-services.json"
    },
    "web": {
      "bundler": "metro",
      "output": "static",
      "favicon": "./assets/favicon.png",
      "name": "Shelfy — la tua dispensa intelligente",
      "shortName": "Shelfy",
      "description": "Tieni traccia dei tuoi alimenti e riduci gli sprechi.",
      "themeColor": "#2f4a31",
      "backgroundColor": "#f5f3ec"
    },
    "plugins": [
      "expo-router",
      "expo-font",
      [
        "expo-camera",
        {
          "cameraPermission": "Shelfy usa la fotocamera per scansionare i codici a barre."
        }
      ],
      [
        "expo-notifications",
        {
          "icon": "./assets/notification-icon.png",
          "color": "#2f4a31"
        }
      ],
      [
        "expo-splash-screen",
        {
          "image": "./assets/splash-icon.png",
          "resizeMode": "contain",
          "backgroundColor": "#fff9ed"
        }
      ],
      "react-native-edge-to-edge",
      "expo-web-browser",
      "@react-native-google-signin/google-signin",
      "expo-sharing",
      "expo-localization",
      "expo-status-bar"
    ],
    "scheme": "shelfy",
    "experiments": {
      "typedRoutes": true
    },
    "extra": {
      "router": {},
      "eas": {
        "projectId": "8ca5efb5-8143-4d62-b20e-a3185df70768"
      },
      "googleAuth": {
        "webClientId": "288975536587-1q7p528mc3t4i9plc9udsknfrc7s5u1m.apps.googleusercontent.com",
        "iosClientId": "",
        "androidClientId": "288975536587-c03grc9acs72v3ksbk4aj2ar2k1sqten.apps.googleusercontent.com"
      },
      "revenueCat": {
        "androidKey": "goog_vfsUpiZZELRATmrwMOmFDbWiGBD",
        "webKey": "rcb_UUHrrtTHiztcxkcaWtjGcxJZURjt",
        "webKeySandbox": "rcb_sb_WeRqKsMNgFTPmZxpjvtYnHFbd"
      }
    }
  }
}
