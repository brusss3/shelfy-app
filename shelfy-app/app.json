{
  "expo": {
    "name": "Shelfy",
    "slug": "shelfy",
    "version": "1.0.0",
    "orientation": "portrait",
    "icon": "./assets/icon.png",
    "userInterfaceStyle": "light",
    "splash": {
      "image": "./assets/splash.png",
      "resizeMode": "cover",
      "backgroundColor": "#2f4a31"
    },
    "assetBundlePatterns": [
      "**/*"
    ],
    "ios": {
      "supportsTablet": false,
      "bundleIdentifier": "com.shelfy.sheflyapp",
      "infoPlist": {
        "NSCameraUsageDescription": "Shelfy usa la fotocamera per scansionare i codici a barre dei prodotti.",
        "NSUserNotificationsUsageDescription": "Shelfy invia notifiche quando i tuoi prodotti stanno per scadere."
      }
    },
    "android": {
      "adaptiveIcon": {
        "foregroundImage": "./assets/adaptive-icon.png",
        "backgroundColor": "#2f4a31"
      },
      "package": "com.shelfy.sheflyapp",
      "permissions": [
        "CAMERA",
        "RECEIVE_BOOT_COMPLETED",
        "VIBRATE",
        "android.permission.CAMERA",
        "android.permission.RECORD_AUDIO"
      ],
      "googleServicesFile": "./google-services.json"
    },
    "web": {
      "bundler": "metro",
      "output": "static",
      "favicon": "./assets/favicon.png",
      "name": "Shelfy — la tua dispensa intelligente",
      "shortName": "Shelfy",
      "description": "Tieni traccia dei tuoi alimenti e riduci gli sprechi.",
      "themeColor": "#2f4a31",
      "backgroundColor": "#f5f3ec"
    },
    "plugins": [
      "expo-router",
      "expo-font",
      [
        "expo-camera",
        {
          "cameraPermission": "Shelfy usa la fotocamera per scansionare i codici a barre."
        }
      ],
      [
        "expo-notifications",
        {
          "icon": "./assets/notification-icon.png",
          "color": "#2f4a31"
        }
      ],
      "react-native-edge-to-edge"
    ],
    "scheme": "shelfy",
    "experiments": {
      "typedRoutes": true
    },
    "extra": {
      "router": {},
      "eas": {
        "projectId": "8ca5efb5-8143-4d62-b20e-a3185df70768"
      }
    }
  }
}
