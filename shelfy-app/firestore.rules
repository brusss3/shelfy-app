rules_version = '2';
service cloud.firestore {
  match /databases/{database}/documents {

    // True se l'utente autenticato ha isAdmin == true nel proprio documento.
    function isAdmin() {
      return request.auth != null
        && get(/databases/$(database)/documents/users/$(request.auth.uid)).data.isAdmin == true;
    }

    // Ogni utente gestisce solo i propri prodotti
    match /users/{userId}/products/{productId} {
      allow read, write: if request.auth != null && request.auth.uid == userId;
    }

    // Ricette community salvate dall'utente per cucinarle dopo
    match /users/{userId}/savedRecipes/{recipeId} {
      allow read, write: if request.auth != null && request.auth.uid == userId;
    }

    // Ricette personali (generate dall'AI o scritte dall'utente): private
    // finché non vengono pubblicate nella community.
    match /users/{userId}/myRecipes/{recipeId} {
      allow read, write: if request.auth != null && request.auth.uid == userId;
    }

    // Contatore delle generazioni AI giornaliere: l'utente lo legge per sapere
    // se ha già usato la ricetta di oggi, ma ci scrive solo la Cloud Function
    // (Admin SDK, che bypassa queste regole).
    match /users/{userId}/aiUsage/{day} {
      allow read: if request.auth != null && request.auth.uid == userId;
      allow write: if false;
    }

    // Limite ai tentativi di unirsi a una dispensa con un codice (contatore
    // orario): solo lettura per l'utente, la Cloud Function lo incrementa con
    // l'Admin SDK. Serve a rendere impraticabile un brute-force sul codice.
    match /users/{userId}/joinAttempts/{hour} {
      allow read: if request.auth != null && request.auth.uid == userId;
      allow write: if false;
    }

    // Helper per verificare che l'utente non modifichi campi riservati (ruoli/abbonamento)
    function notUpdatingProtectedFields() {
      return !request.resource.data.diff(resource.data).affectedKeys().hasAny(['isAdmin', 'isPremium', 'subscriptionType', 'subscriptionExpiresAt', 'aiDisabled']);
    }

    // Documento utente: l'utente legge il proprio; l'admin può leggere tutti.
    // L'utente può creare il proprio documento iniziale purché isAdmin e isPremium non siano true.
    // L'utente può aggiornare solo campi non protetti (es. displayName, email, notificationsEnabled).
    // Solo un admin può modificare i campi protetti (isAdmin, isPremium, ecc.).
    match /users/{userId} {
      allow read: if request.auth != null && (request.auth.uid == userId || isAdmin());
      allow create: if request.auth != null && request.auth.uid == userId
                    && request.resource.data.get('isAdmin', false) == false
                    && request.resource.data.get('isPremium', false) == false;
      allow update: if (request.auth != null && request.auth.uid == userId && notUpdatingProtectedFields())
                    || isAdmin();
      allow delete: if request.auth != null && (request.auth.uid == userId || isAdmin());
    }

    // Interruttori globali (es. config/ai { enabled }): tutti li leggono per
    // sapere se una feature è attiva, solo l'admin li cambia.
    match /config/{docId} {
      allow read: if request.auth != null;
      allow write: if isAdmin();
    }

    // Feedback: ogni utente autenticato può inviarlo; solo l'admin può leggerlo
    // e aggiornarne lo stato (nuovo/letto/risolto).
    match /feedback/{docId} {
      allow create: if request.auth != null;
      allow read, update: if isAdmin();
    }

    // Ricette community: lettura per ogni utente autenticato, scrittura piena
    // solo per l'autore. Eccezione: chiunque può aggiornare SOLO ratingSum/
    // ratingCount (il voto), mai gli altri campi della ricetta.
    match /communityRecipes/{recipeId} {
      allow read: if request.auth != null;
      allow create: if request.auth != null && request.resource.data.authorId == request.auth.uid;
      allow update: if request.auth != null && (
        resource.data.authorId == request.auth.uid ||
        request.resource.data.diff(resource.data).affectedKeys().hasOnly(['ratingSum', 'ratingCount'])
      );
      allow delete: if request.auth != null && resource.data.authorId == request.auth.uid;

      // Un voto per utente: id documento = uid di chi vota.
      match /ratings/{uid} {
        allow read: if request.auth != null;
        allow create, update, delete: if request.auth != null && request.auth.uid == uid;
      }
    }

    // Richieste d'aiuto ("mi scadono questi ingredienti"): lettura pubblica,
    // solo l'autore può modificarle/chiuderle/cancellarle.
    match /recipeRequests/{requestId} {
      allow read: if request.auth != null;
      allow create: if request.auth != null && request.resource.data.authorId == request.auth.uid;
      allow update, delete: if request.auth != null && resource.data.authorId == request.auth.uid;

      // Proposte di ricetta a una richiesta: chiunque può proporre, solo chi
      // ha proposto può ritirare la propria proposta.
      match /proposals/{proposalId} {
        allow read: if request.auth != null;
        allow create: if request.auth != null && request.resource.data.authorId == request.auth.uid;
        allow delete: if request.auth != null && resource.data.authorId == request.auth.uid;
      }
    }

    // ---------------------------------------------------------------------
    // Dispensa condivisa
    // ---------------------------------------------------------------------
    // Si entra SOLO tramite la Cloud Function joinPantry (Admin SDK, bypassa
    // queste regole): verifica il codice invito lato server, applica un
    // limite di tentativi e un tetto massimo di membri. Dal client non è mai
    // possibile scrivere memberIds/members — questa è la garanzia che nessuno
    // possa aggiungersi da solo o essere aggiunto senza un codice valido.
    match /pantries/{pantryId} {
      allow read: if request.auth != null && request.auth.uid in resource.data.memberIds;

      // L'unica scrittura permessa dal client è rinominare la propria
      // dispensa (solo il creatore, solo il campo `name`). Creazione,
      // ingresso, uscita, rimozione membri, rotazione/disattivazione del
      // codice ed eliminazione passano tutte da Cloud Function dedicate.
      allow update: if request.auth != null
                    && resource.data.ownerId == request.auth.uid
                    && request.resource.data.diff(resource.data).affectedKeys().hasOnly(['name'])
                    && request.resource.data.name is string
                    && request.resource.data.name.size() > 0
                    && request.resource.data.name.size() <= 60;
      allow create, delete: if false;

      // Codice invito attivo: leggibile SOLO dal creatore, mai dagli altri
      // membri — è il requisito esplicito "pin visibile da chi crea la
      // dispensa". Per questo vive qui e non su un campo del documento
      // principale (che tutti i membri possono leggere).
      match /private/{docId} {
        allow read: if request.auth != null
          && get(/databases/$(database)/documents/pantries/$(pantryId)).data.ownerId == request.auth.uid;
        allow write: if false;
      }

      // Prodotti della dispensa condivisa: chiunque sia membro ORA (verifica
      // in tempo reale sul documento dispensa, non su un campo duplicato sul
      // prodotto) può leggere e gestire tutto — è il senso di "condivisa".
      match /products/{productId} {
        allow read, write: if request.auth != null
          && request.auth.uid in get(/databases/$(database)/documents/pantries/$(pantryId)).data.memberIds;
      }
    }

    // Codici invito: risolvono codice -> dispensa. Mai leggibili/scrivibili
    // dal client (altrimenti chiunque potrebbe elencare o indovinare codici
    // altrui) — solo la Cloud Function li usa con l'Admin SDK.
    match /inviteCodes/{code} {
      allow read, write: if false;
    }

    // Tutto il resto è bloccato
    match /{document=**} {
      allow read, write: if false;
    }
  }
}
