rules_version = '2';
service cloud.firestore {
  match /databases/{database}/documents {

    // True se l'utente autenticato ha isAdmin == true nel proprio documento.
    function isAdmin() {
      return request.auth != null
        && get(/databases/$(database)/documents/users/$(request.auth.uid)).data.isAdmin == true;
    }

    // Ogni utente gestisce solo i propri prodotti
    match /users/{userId}/products/{productId} {
      allow read, write: if request.auth != null && request.auth.uid == userId;
    }

    // Documento utente: l'utente legge/scrive il proprio; l'admin può leggere
    // tutti e aggiornarli (es. abilitare Premium).
    match /users/{userId} {
      allow read: if request.auth != null && (request.auth.uid == userId || isAdmin());
      allow create, update, delete: if request.auth != null && request.auth.uid == userId;
      allow update: if isAdmin();
    }

    // Feedback: ogni utente autenticato può inviarlo; solo l'admin può leggerlo.
    match /feedback/{docId} {
      allow create: if request.auth != null;
      allow read: if isAdmin();
    }

    // Tutto il resto è bloccato
    match /{document=**} {
      allow read, write: if false;
    }
  }
}
